	_:bcfd2bd157fab3352a4fa7e19b177f8a <http://www.w3.org/ns/shacl#prefixes> <https://linked.archi/examples/archisurance/shapes/cross-model> ;
		<http://www.w3.org/ns/shacl#message> "XR-6: {?label} is a {?srcType} but corresponds to an ArchiMate {?amType}; no cross-language mapping relates the two types."@en ;
		<http://www.w3.org/ns/shacl#select> "\n            SELECT $this ?value ?label ?srcType ?amType WHERE {\n                $this skos:exactMatch|skos:closeMatch ?kg .\n                ?value owl:sameAs ?kg ; a ?amType .\n                FILTER(STRSTARTS(STR(?amType), \"https://meta.linked.archi/archimate3/onto#\"))\n                $this a ?srcType .\n                FILTER(STRSTARTS(STR(?srcType), \"https://meta.linked.archi/backstage/onto#\")\n                    || STRSTARTS(STR(?srcType), \"https://meta.linked.archi/leanix/onto#\"))\n                # most specific ArchiMate type only\n                FILTER NOT EXISTS { ?value a ?sub . ?sub rdfs:subClassOf ?amType . FILTER(?sub != ?amType) }\n                FILTER NOT EXISTS { $this a ?sub2 . ?sub2 rdfs:subClassOf ?srcType . FILTER(?sub2 != ?srcType) }\n                OPTIONAL { $this skos:prefLabel ?prefLabel }\n                BIND(COALESCE(?prefLabel, STR($this)) AS ?label)\n                # the source type is one the cross-mappings cover at all\n                FILTER EXISTS { ?srcType skos:exactMatch|skos:closeMatch|skos:relatedMatch ?any }\n                FILTER NOT EXISTS {\n                    $this a ?st .\n                    ?st skos:exactMatch|skos:closeMatch|skos:relatedMatch ?amType .\n                }\n            }\n        " ;
		a <http://www.w3.org/ns/shacl#SPARQLConstraint> .
	<https://linked.archi/examples/archisurance/shapes/cross-model#InstanceLinkMatchesTypeMapping> <http://www.w3.org/ns/shacl#sparql> _:bcfd2bd157fab3352a4fa7e19b177f8a ;
		<http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info> ;
		<http://www.w3.org/ns/shacl#targetSubjectsOf> <http://www.w3.org/2004/02/skos/core#closeMatch> , <http://www.w3.org/2004/02/skos/core#exactMatch> ;
		a <http://www.w3.org/ns/shacl#NodeShape> .
	_:d8cad65ec843673a87ae5843bd1835aa <http://www.w3.org/ns/shacl#sourceShape> <https://linked.archi/examples/archisurance/shapes/cross-model#InstanceLinkMatchesTypeMapping> ;
