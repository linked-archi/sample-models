	<https://linked.archi/examples/vio/concepts#owner> <http://www.w3.org/2004/02/skos/core#scopeNote> "Backstage owner (vio:ownedBy) is the operating team; LeanIX ACCOUNTABLE subscriber is a person. Prefer the team."@en ;
		<http://www.w3.org/2004/02/skos/core#altLabel> "responsible"@en , "owning team"@en ;
		<http://www.w3.org/2004/02/skos/core#prefLabel> "owner"@en ;
