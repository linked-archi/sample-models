  <folder name="Application" id="id-89d33db6292c3a5993293a542ba09c45" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Finance Ledger" id="id-77b0cf0903a4">
      <documentation>General ledger and revenue recognition.</documentation>
      <property key="@id" value="application-component/finance-ledger"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Trade Partner Portal" id="id-cb2d478a69fb">
      <documentation>B2B portal for travel agencies. LeanIX still calls it 'Reservation Portal'.</documentation>
      <property key="@id" value="application-component/trade-partner-portal"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Excursion Booking Service" id="id-9e48ecd2951e">
      <property key="@id" value="application-service/excursion-booking-service"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Booking Orchestration Service" id="id-2f98ce500322">
      <property key="@id" value="application-service/booking-orchestration-service"/>
      <property key="arch:architectureState" value="arch:Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Availability Service" id="id-3412690e1a51">
      <property key="@id" value="application-service/availability-service"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Benelux Booking Service" id="id-1bbbe221e11c">
      <property key="@id" value="application-service/benelux-booking-service"/>
      <property key="arch:architectureState" value="arch:Baseline"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Customer Notification Service" id="id-38cbfc854b4b">
      <documentation>E-mail, SMS and push notifications to travellers.</documentation>
      <property key="@id" value="application-component/notification-service"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Flight Inventory Connector" id="id-5dfba53a9b39">
      <documentation>Seat availability from the group airline and third-party carriers.</documentation>
      <property key="@id" value="application-component/flight-inventory-connector"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Reservation Platform" id="id-8feb96f10dbb">
      <documentation>Core reservation system of record for package holidays since 2004.</documentation>
      <property key="@id" value="application-component/reservation-platform"/>
      <property key="arch:architectureState" value="arch:Baseline"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Flight Availability Service" id="id-9783234debdf">
      <property key="@id" value="application-service/flight-availability-service"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Notification API" id="id-49bff92c741a">
      <property key="@id" value="application-service/notification-api"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Inventory Hub" id="id-3a57f504cf8b">
      <documentation>Hotel allotments and availability across all source markets.</documentation>
      <property key="@id" value="application-component/inventory-hub"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Booking Orchestrator" id="id-782b51aaa28f">
      <documentation>Event-driven booking orchestration replacing the Reservation Platform.</documentation>
      <property key="@id" value="application-component/booking-orchestrator"/>
      <property key="arch:architectureState" value="arch:Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Customer Profile Service" id="id-d111fc2d941c">
      <documentation>Traveller profiles, consent and preferences.</documentation>
      <property key="@id" value="application-component/customer-profile-service"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contracting System" id="id-8400a6af817a">
      <documentation>Hotel and supplier contract management.</documentation>
      <property key="@id" value="application-component/contracting-system"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Booking Service" id="id-e3483901cc51">
      <property key="@id" value="application-service/booking-service"/>
      <property key="arch:architectureState" value="arch:Baseline"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Benelux Reservation System" id="id-84617035d69d">
      <documentation>Reservation system of the Benelux market for coach and charter holidays, taken over with a regional tour operator in 2015.</documentation>
      <property key="@id" value="application-component/benelux-reservation-system"/>
      <property key="arch:architectureState" value="arch:Baseline"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Dynamic Packaging Engine" id="id-87e933647a76">
      <documentation>Assembles flight, hotel and transfer components into bookable packages.</documentation>
      <property key="@id" value="application-component/dynamic-packaging-engine"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Payment Service" id="id-2c66c4a3f22e">
      <property key="@id" value="application-service/payment-service"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Payment Gateway" id="id-07d01822f5f1">
      <documentation>Card and alternative payment orchestration.</documentation>
      <property key="@id" value="application-component/payment-gateway"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Pricing Engine" id="id-ac772b344a85">
      <documentation>Dynamic pricing and yield rules.</documentation>
      <property key="@id" value="application-component/pricing-engine"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Ledger Posting Service" id="id-6f24db0680f2">
      <property key="@id" value="application-service/ledger-posting-service"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Pricing Service" id="id-1d96b2640902">
      <property key="@id" value="application-service/pricing-service"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Web Shop" id="id-a99054440ef4">
      <documentation>B2C web and app shop for all source markets.</documentation>
      <property key="@id" value="application-component/web-shop"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Package Assembly Service" id="id-81ad645744b4">
      <property key="@id" value="application-service/package-assembly-service"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Contract Load Service" id="id-a9a4e69c92b5">
      <property key="@id" value="application-service/contract-load-service"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Data Lakehouse" id="id-633f7623f350">
      <documentation>Group analytics platform fed by booking and customer events.</documentation>
      <property key="@id" value="application-component/data-lakehouse"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Customer Profile API" id="id-35f2b70fb765">
      <property key="@id" value="application-service/customer-profile-api"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Destination Services Platform" id="id-be5b9ecb558b">
      <documentation>Transfers, excursions and resort representatives.</documentation>
      <property key="@id" value="application-component/destination-services-platform"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Agent Desktop" id="id-d3899217bf7c">
      <documentation>Retail shop and contact centre booking desktop.</documentation>
      <property key="@id" value="application-component/agent-desktop"/>
    </element>
  </folder>
