@prefix arch: <https://meta.linked.archi/core#>.
@prefix arch-vis: <https://meta.linked.archi/core-vis#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix am4: <https://meta.linked.archi/archimate4/onto#>.
@prefix am4mm: <https://meta.linked.archi/archimate4/metamodel#>.
@prefix am4vp: <https://meta.linked.archi/archimate4/viewpoints#>.
@prefix m: <https://example.org/acme/shop/>.

m:card-payment a am4:Service;
    skos:prefLabel "Card payment"@en;
    am4:serves m:web-shop;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:card-payment-serves-web-shop a am4:Serving;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:card-payment;
    arch:target m:web-shop.
m:customer a am4:BusinessActor;
    skos:prefLabel "Customer"@en;
    am4:assignedTo m:place-order;
    arch:inModel m:model;
    arch:inView m:view-service-realization, m:view-who-is-who.
m:customer-assigned-to-place-order a am4:Assignment;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:customer;
    arch:target m:place-order.
m:gift-wrapping a am4:Service;
    skos:prefLabel "Gift wrapping"@en;
    am4:serves m:customer;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:gift-wrapping-serves-customer a am4:Serving;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:gift-wrapping;
    arch:target m:customer.
m:link-card-payment-serves-web-shop a arch-vis:Link;
    arch-vis:archRelationship m:card-payment-serves-web-shop;
    arch-vis:source m:node-card-payment;
    arch-vis:target m:node-web-shop;
    arch-vis:view m:view-service-realization.
m:link-customer-assigned-to-place-order a arch-vis:Link;
    arch-vis:archRelationship m:customer-assigned-to-place-order;
    arch-vis:source m:node-customer;
    arch-vis:target m:node-place-order;
    arch-vis:view m:view-service-realization.
m:link-gift-wrapping-serves-customer a arch-vis:Link;
    arch-vis:archRelationship m:gift-wrapping-serves-customer;
    arch-vis:source m:node-gift-wrapping;
    arch-vis:target m:node-customer;
    arch-vis:view m:view-service-realization.
m:link-online-ordering-serves-place-order a arch-vis:Link;
    arch-vis:archRelationship m:online-ordering-serves-place-order;
    arch-vis:source m:node-online-ordering;
    arch-vis:target m:node-place-order;
    arch-vis:view m:view-service-realization.
m:link-payments-realizes-card-payment a arch-vis:Link;
    arch-vis:archRelationship m:payments-realizes-card-payment;
    arch-vis:source m:node-payments;
    arch-vis:target m:node-card-payment;
    arch-vis:view m:view-service-realization.
m:link-shop-team-associated-with-payments a arch-vis:Link;
    arch-vis:archRelationship m:shop-team-associated-with-payments;
    arch-vis:source m:node-shop-team;
    arch-vis:target m:node-payments;
    arch-vis:view m:view-service-realization.
m:link-shop-team-associated-with-web-shop a arch-vis:Link;
    arch-vis:archRelationship m:shop-team-associated-with-web-shop;
    arch-vis:source m:node-shop-team;
    arch-vis:target m:node-web-shop;
    arch-vis:view m:view-service-realization.
m:link-web-shop-realizes-online-ordering a arch-vis:Link;
    arch-vis:archRelationship m:web-shop-realizes-online-ordering;
    arch-vis:source m:node-web-shop;
    arch-vis:target m:node-online-ordering;
    arch-vis:view m:view-service-realization.
m:model a arch:Model;
    skos:editorialNote "Gift wrapping is realized by nothing on purpose: the documentation's Validation screenshot shows the ServiceWithoutRealizationShape warning it raises."@en;
    skos:prefLabel "Acme online shop"@en;
    arch:modelConformsToMetamodel am4mm:ArchiMate4.
m:node-card-payment a arch-vis:ArchNode;
    arch-vis:archElement m:card-payment;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "440"^^xsd:double;
    arch-vis:bounds-y "280"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-customer a arch-vis:ArchNode;
    arch-vis:archElement m:customer;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "40"^^xsd:double;
    arch-vis:bounds-y "40"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-gift-wrapping a arch-vis:ArchNode;
    arch-vis:archElement m:gift-wrapping;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "40"^^xsd:double;
    arch-vis:bounds-y "160"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-online-ordering a arch-vis:ArchNode;
    arch-vis:archElement m:online-ordering;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "240"^^xsd:double;
    arch-vis:bounds-y "160"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-payments a arch-vis:ArchNode;
    arch-vis:archElement m:payments;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "440"^^xsd:double;
    arch-vis:bounds-y "400"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-place-order a arch-vis:ArchNode;
    arch-vis:archElement m:place-order;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "240"^^xsd:double;
    arch-vis:bounds-y "40"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-shop-team a arch-vis:ArchNode;
    arch-vis:archElement m:shop-team;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "40"^^xsd:double;
    arch-vis:bounds-y "400"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:node-web-shop a arch-vis:ArchNode;
    arch-vis:archElement m:web-shop;
    arch-vis:bounds-h "55"^^xsd:double;
    arch-vis:bounds-w "120"^^xsd:double;
    arch-vis:bounds-x "240"^^xsd:double;
    arch-vis:bounds-y "280"^^xsd:double;
    arch-vis:view m:view-service-realization.
m:online-ordering a am4:Service;
    skos:prefLabel "Online ordering"@en;
    am4:serves m:place-order;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:online-ordering-serves-place-order a am4:Serving;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:online-ordering;
    arch:target m:place-order.
m:payments a am4:ApplicationComponent;
    skos:prefLabel "Payments"@en;
    am4:realizes m:card-payment;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:payments-realizes-card-payment a am4:Realization;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:payments;
    arch:target m:card-payment.
m:place-order a am4:Process;
    skos:prefLabel "Place order"@en;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:shop-team a am4:BusinessActor;
    skos:prefLabel "Shop team"@en;
    am4:associatedWith m:payments, m:web-shop;
    arch:inModel m:model;
    arch:inView m:view-service-realization, m:view-who-is-who.
m:shop-team-associated-with-payments a am4:Association;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:shop-team;
    arch:target m:payments.
m:shop-team-associated-with-web-shop a am4:Association;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:shop-team;
    arch:target m:web-shop.
m:view-service-realization a arch:Diagram, arch:View;
    skos:prefLabel "How the shop serves its customers"@en;
    arch:inModel m:model;
    arch:viewConformsToViewpoint am4vp:ServiceRealizationViewpoint.
m:view-who-is-who a arch:Catalog, arch:View;
    skos:prefLabel "Who is who"@en;
    arch:inModel m:model;
    arch:viewConformsToViewpoint am4vp:OrganizationViewpoint.
m:web-shop a am4:ApplicationComponent;
    skos:prefLabel "Web shop"@en;
    am4:realizes m:online-ordering;
    arch:inModel m:model;
    arch:inView m:view-service-realization.
m:web-shop-realizes-online-ordering a am4:Realization;
    arch:inModel m:model;
    arch:inView m:view-service-realization;
    arch:source m:web-shop;
    arch:target m:online-ordering.
